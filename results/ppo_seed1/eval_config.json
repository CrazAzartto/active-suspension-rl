      },
      {
        "name": "rough_B_15",
        "group": "train-distribution",
        "road": "rough_B",
        "speed": 15.0,
        "n_seeds": 20
      },
      {
        "name": "rough_C_15",
        "group": "train-distribution",
        "road": "rough_C",
        "speed": 15.0,
        "n_seeds": 20
      },
      {
        "name": "heldout_bump_tall",
