          "initial_state": [
            0.02,
            0.0,
            0.0,
            0.0
          ]
        },
        "deterministic": true,
        "note": "flat road, body displaced +20 mm at t=0 (free-decay test); identical for both controllers"
      },
      {
        "name": "bump_10",
