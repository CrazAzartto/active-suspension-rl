        "road": {
          "kind": "bump",
          "height": 0.055,
          "length": 3.5,
          "start": 10.0,
          "speed": 16.0
        },
        "speed": 16.0,
        "n_seeds": 1,
        "deterministic": true,
        "note": "taller/longer/faster than any training bump (train: h<=0.04, L<=3, v<=14)"
